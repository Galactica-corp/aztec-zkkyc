{
  "name": "@galactica-net/aztec-zkkyc",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/Galactica-corp/aztec-zkkyc.git",
  "author": "Galactica Network <info@galactica.com>",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/demo",
    "apps/guardian-frontend-reference",
    "services/guardian-aztec-connect",
    "services/guardian-backend"
  ],
  "type": "module",
  "scripts": {
    "fees": "NODE_NO_WARNINGS=1 tsx scripts/fees.ts",
    "fees::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/fees.ts",
    "clean": "rm -rf ./artifacts ./target",
    "clear-store": "rm -rf ./store",
    "codegen": "aztec codegen target --outdir artifacts --force",
    "compile": "rm -rf ./node_modules/@alejoamiras/private-fee-juice/src/ts/dist/target ./apps/demo/node_modules/@alejoamiras/private-fee-juice/src/ts/dist/target ./node_modules/@aztec-foundation/aztec-standards/target ./apps/demo/node_modules/@aztec-foundation/aztec-standards/target ./apps/demo/contracts/ecdsa_k_eth_signer_account/target ./apps/demo/src/target ./apps/demo/target && aztec compile --workspace",
    "deploy::sandbox": "yarn clean::sandbox && yarn deploy-account && yarn deploy-contracts",
    "clean::sandbox": "rm -rf pxe_data_* wallet_data_* aztec-wallet-data *-stores",
    "deploy-contracts": "NODE_NO_WARNINGS=1 tsx scripts/deploy_contract.ts",
    "deploy::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/deploy_contract.ts",
    "deploy-new-account": "NODE_NO_WARNINGS=1 tsx scripts/deploy_new_account.ts",
    "deploy-new-account::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/deploy_new_account.ts",
    "deploy-account": "NODE_NO_WARNINGS=1 tsx scripts/deploy_account_from_env.ts",
    "deploy-account::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/deploy_account_from_env.ts",
    "interaction-existing-contract": "NODE_NO_WARNINGS=1 tsx scripts/interaction_existing_contract.ts",
    "interaction-existing-contract::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/interaction_existing_contract.ts",
    "multiple-wallet": "NODE_NO_WARNINGS=1 tsx scripts/multiple_wallet.ts",
    "multiple-wallet::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/multiple_wallet.ts",
    "get-block": "NODE_NO_WARNINGS=1 tsx scripts/get_block.ts",
    "get-block::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/get_block.ts",
    "postinstall": "patch-package",
    "profile": "NODE_NO_WARNINGS=1 tsx scripts/profile_deploy.ts",
    "profile::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet tsx scripts/profile_deploy.ts",
    "test": "yarn test:js && yarn test:nr",
    "test::testnet": "AZTEC_ENV=testnet yarn test:js",
    "test:js": "rm -rf store/pxe store aztec-wallet-data *-stores pxe_data_* wallet_data_* && NODE_NO_WARNINGS=1 node --experimental-vm-modules $(yarn bin jest) --no-cache --runInBand --config jest.integration.config.json",
    "test:nr": "aztec test --workspace",
    "update-readme-version": "node ./.github/scripts/update-readme-version.js"
  },
  "dependencies": {
    "@aztec/accounts": "5.0.1",
    "@aztec/aztec.js": "5.0.1",
    "@aztec/constants": "5.0.1",
    "@aztec/kv-store": "5.0.1",
    "@aztec/noir-contracts.js": "5.0.1",
    "@aztec/protocol-contracts": "5.0.1",
    "@aztec/pxe": "5.0.1",
    "@aztec/stdlib": "5.0.1",
    "@aztec/wallets": "5.0.1",
    "@alejoamiras/private-fee-juice": "5.0.1",
    "@galactica-net/galactica-types": "^0.5.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.15.1",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "4.21.0",
    "typescript": "^5.4.4"
  },
  "jest": {
    "testTimeout": 200000
  },
  "resolutions": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
